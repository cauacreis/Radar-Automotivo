# ================================
# Radar Automotivo — Variáveis de Ambiente
# ================================
# Copie este arquivo para .env e preencha com seus valores reais.
# NUNCA suba o arquivo .env para o Git!

# Groq AI API Key
GROQ_API_KEY=sua_chave_aqui

# Telegram Bot
# Crie um bot com o @BotFather no Telegram e copie o token
TELEGRAM_BOT_TOKEN=seu_token_aqui
# Para obter o CHAT_ID: envie uma msg ao bot e acesse
# https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_CHAT_ID=seu_chat_id_aqui
